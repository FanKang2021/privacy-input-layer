{
  "manifest_version": 3,
  "name": "privacy-input-layer",
  "version": "0.4.2",
  "description": "Mask secrets in web AI chat inputs at paste time. Complements the OS-level guard.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["rules.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "privacy-input-layer"
  }
}